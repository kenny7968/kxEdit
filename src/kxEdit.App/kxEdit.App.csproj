<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>kxEdit</AssemblyName>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIA 型（System.Windows.Automation）の連鎖参照のため UseWPF も有効化 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\kxEdit.Accessibility\kxEdit.Accessibility.csproj" />
    <ProjectReference Include="..\kxEdit.Editor\kxEdit.Editor.csproj" />
    <ProjectReference Include="..\kxEdit.Core\kxEdit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <ItemGroup>
    <!-- PublishReadyToRun で crossgen2 が再生成すると Microsoft の Authenticode 署名が消える
         (Valid → NotSigned)。これらは Markdown プレビューを開いたときにしか読み込まれないため、
         ReadyToRun 化しても起動の改善には効かない。性能改善フェーズ 11・最終レビュー脆弱性パス。 -->
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.Core.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.WinForms.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.Wpf.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Speech 系(UiaAnnouncer)は internal のため、契約テスト用に公開する。
         Core/Editor/Accessibility と同じテスト専用の慣例 -->
    <InternalsVisibleTo Include="kxEdit.App.Tests" />
  </ItemGroup>
</Project>
